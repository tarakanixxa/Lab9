PREFIX : <http://example.org/manufacturing-ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT ?product ?productName ?defect ?defectName WHERE {
  :ПеревіркаВала :перевіряє ?product ;
                 :виявляє ?defect .
  ?product :назва ?productName .
  ?defect :назва ?defectName .
}
