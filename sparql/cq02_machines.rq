PREFIX : <http://example.org/manufacturing-ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT ?workshop ?workshopName ?machine ?machineName WHERE {
  :МеханічнийЦех :використовуєОбладнання ?machine .
  :МеханічнийЦех :назва ?workshopName .
  ?machine :назва ?machineName .
  BIND(:МеханічнийЦех AS ?workshop)
}
