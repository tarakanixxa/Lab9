PREFIX : <http://example.org/manufacturing-ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT ?process ?processName ?operation ?operationName WHERE {
  :ПроцесВиготовленняВала :маєОперацію ?operation .
  :ПроцесВиготовленняВала :назва ?processName .
  ?operation :назва ?operationName .
  BIND(:ПроцесВиготовленняВала AS ?process)
}
